# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Session 41-LOCAL — allow-list the example file so it can be committed
# while the real .env.local-stack stays gitignored (caught by .env*).
!.env.local-stack.example

# Session 41-LOCAL — local Docker stack overrides (per-developer tweaks
# layered on top of docker-compose.local.yml). The base compose file IS
# committed; this override pattern is opt-in and per-machine.
docker-compose.local.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.unlighthouse/

# Local DB backups — never commit
backups/
