# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Session 41-LOCAL — allow-list the example file so it can be committed
# while the real .env.local-stack stays gitignored (caught by .env*).
!.env.local-stack.example

# Session 41-v3-FIX1 — bootstrap/ moved into public-site/.
# `bootstrap/.env` stays gitignored via the .env* rule above; the
# .env.example template is allow-listed here so it lands in the commit
# while the real .env stays out. Other locally-generated artifacts
# (node_modules, build outputs) excluded.
!bootstrap/.env.example
bootstrap/node_modules/
bootstrap/.tsbuildinfo
bootstrap/dist/
# Bootstrap's mnt/ is a Claude Code user-data mount point full of
# .DS_Store + nested .env.example files from C1-era artifact bundles.
# Skip the whole directory — nothing useful to version.
bootstrap/mnt/

# Local DB backups — never commit (production data dumps stored here)
backups/

# Session 41-LOCAL — local Docker stack overrides (per-developer tweaks
# layered on top of docker-compose.local.yml). The base compose file IS
# committed; this override pattern is opt-in and per-machine.
docker-compose.local.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.unlighthouse/
