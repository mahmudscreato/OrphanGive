# OrphanGive — Directus environment configuration
#
# Copy this file to .env (cp .env.example .env)
# Fill in every value below
# Then: docker compose up -d
#
# Generate KEY and SECRET with: openssl rand -hex 32

# ===== CORE =====
KEY=replace-with-output-of-openssl-rand-hex-32
SECRET=replace-with-another-output-of-openssl-rand-hex-32
PUBLIC_URL=https://admin.orphangive.org

# ===== ADMIN USER (created on first run) =====
ADMIN_EMAIL=mahmud@orphangive.org
ADMIN_PASSWORD=use-a-strong-password-from-a-password-manager

# ===== DATABASE =====
DB_PASSWORD=use-another-strong-password

# ===== CORS (your public website's origin) =====
# Comma-separated list. While developing locally, include http://localhost:3000.
# Once the public site is live, replace with the production origins.
CORS_ORIGIN=https://orphangive.org,https://www.orphangive.org,http://localhost:3000

# ===== STORAGE =====
# Default is local file storage on the VPS. Once Cloudinary is set up,
# change STORAGE_LOCATIONS to "cloud" and fill in the Cloudinary fields.
STORAGE_LOCATIONS=local
# STORAGE_LOCATIONS=cloud
# STORAGE_CLOUD_DRIVER=cloudinary
# STORAGE_CLOUD_CLOUD_NAME=your-cloudinary-cloud-name
# STORAGE_CLOUD_API_KEY=your-cloudinary-api-key
# STORAGE_CLOUD_API_SECRET=your-cloudinary-api-secret

# ===== EMAIL (Resend) =====
EMAIL_FROM=OrphanGive <hello@orphangive.org>
RESEND_API_KEY=re_your_resend_api_key_here

# ===== FUTURE: payment gateways =====
# These aren't used by Directus directly — they live in the public website's
# .env, not here. Documented for reference.
# SSLCOMMERZ_STORE_ID=...
# SSLCOMMERZ_STORE_PASSWORD=...
# STRIPE_SECRET_KEY=...
# STRIPE_WEBHOOK_SECRET=...
