# Keep the build context lean — anything that isn't part of the
# source tree or needed by `npm run build` should be excluded.
# Speeds up local + VPS builds significantly.

node_modules
.next
.turbo
.git
.gitignore

# Local secrets — production env comes from --env-file at runtime,
# never baked into the image.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs + caches
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
.DS_Store

# Editor / IDE
.vscode
.idea
*.swp

# Repo-internal docs / artifacts that don't ship with the app
docs
README.md
CLAUDE.md
AGENTS.md
migrations
scripts/repair
tsconfig.tsbuildinfo
