# Local Directus stack — example values.
# Copy to .env.local-stack (gitignored) and fill in real values before
# running `docker compose -f docker-compose.local.yml up -d`.
#
# This file is COMMITTED. The real .env.local-stack with secrets is NOT.

# ─── Directus app secrets ────────────────────────────────────────────
# Generate fresh UUIDs for local. Do NOT reuse the VPS KEY/SECRET —
# those are production secrets. Quick generation:
#   node -e "console.log(crypto.randomUUID())"
DIRECTUS_KEY=00000000-0000-0000-0000-000000000000
DIRECTUS_SECRET=00000000-0000-0000-0000-000000000000

# ─── Local Directus admin (bootstrap account) ────────────────────────
# Used by Directus to create the initial admin user on FIRST RUN of an
# empty DB. After the production dump is restored (Step 8 of
# Session 41-LOCAL APPLY), the dump's admin users own the system and
# this bootstrap account is irrelevant — you'll log in with VPS admin
# credentials. These values still need to be present so Directus boots.
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=ChangeMe2026!

# ─── Postgres credentials ────────────────────────────────────────────
# Must match what docker-compose.local.yml passes to the postgres
# container. Defaults are fine for local-only use.
DB_USER=directus
DB_PASSWORD=directus_local_dev
DB_DATABASE=directus

# ─── Analytics (Google Analytics 4) ──────────────────────────────────
# GA4 measurement id. LEAVE BLANK unless you actually want analytics on
# this environment. When unset, analytics never loads (Analytics.tsx
# no-ops and the consent banner never shows — there's nothing to consent
# to). When set, GA4 still loads ONLY after the visitor clicks "Accept"
# in the consent banner (opt-in / deny-by-default), and child-route
# paths + titles + query strings are redacted before anything reaches
# Google. Set the real id in the production app.env at deploy time only.
NEXT_PUBLIC_GA_ID=
